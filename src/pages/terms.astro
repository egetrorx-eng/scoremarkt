---
/**
 * Terms of Service - ScoreMarkt
 * ═══════════════════════════════════════════════════════════════
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/astro/Header.astro';
import Footer from '@/components/astro/Footer.astro';

const lastUpdated = 'January 15, 2025';
---

<BaseLayout 
  title="Terms of Service" 
  description="ScoreMarkt terms of service and user agreement."
>
  <Header />

  <main class="min-h-screen py-12 md:py-20">
    <div class="container-narrow">
      <div class="prose prose-invert max-w-none">
        <h1>Terms of Service</h1>
        <p class="text-white/50 text-sm">Last updated: {lastUpdated}</p>

        <h2>1. Acceptance of Terms</h2>
        <p>
          By accessing or using ScoreMarkt ("Service"), you agree to be bound by these Terms of Service. 
          If you do not agree to these terms, do not use the Service.
        </p>

        <h2>2. Description of Service</h2>
        <p>
          ScoreMarkt is a frontend interface for accessing prediction markets powered by Polymarket. 
          We facilitate the discovery and trading of football-related prediction markets. 
          All trades are executed on the Polymarket protocol on the Polygon blockchain.
        </p>

        <h2>3. Eligibility</h2>
        <p>You must be:</p>
        <ul>
          <li>At least 18 years of age (or the age of majority in your jurisdiction)</li>
          <li>Located in a jurisdiction where prediction market trading is legal</li>
          <li>Not subject to any sanctions or restrictions</li>
        </ul>

        <h2>4. User Responsibilities</h2>
        <p>You are responsible for:</p>
        <ul>
          <li>Maintaining the security of your wallet and private keys</li>
          <li>All activity that occurs under your account</li>
          <li>Complying with all applicable laws in your jurisdiction</li>
          <li>Any taxes owed on trading profits</li>
        </ul>

        <h2>5. Risk Disclosure</h2>
        <p>
          <strong>Trading on prediction markets involves substantial risk.</strong> You may lose some 
          or all of your investment. Only trade with funds you can afford to lose. Past performance 
          is not indicative of future results.
        </p>
        <p>
          Cryptocurrency and blockchain technologies carry additional risks including but not limited to:
        </p>
        <ul>
          <li>Price volatility</li>
          <li>Smart contract vulnerabilities</li>
          <li>Network congestion and failed transactions</li>
          <li>Regulatory changes</li>
        </ul>

        <h2>6. No Financial Advice</h2>
        <p>
          Nothing on ScoreMarkt constitutes financial, investment, legal, or tax advice. 
          All content is for informational purposes only. You should consult a qualified professional 
          before making any financial decisions.
        </p>

        <h2>7. Prohibited Activities</h2>
        <p>You may not:</p>
        <ul>
          <li>Use the Service for any illegal purpose</li>
          <li>Attempt to manipulate markets or engage in fraud</li>
          <li>Use automated systems to gain unfair advantage</li>
          <li>Circumvent any security measures</li>
          <li>Impersonate other users or entities</li>
        </ul>

        <h2>8. Intellectual Property</h2>
        <p>
          The ScoreMarkt name, logo, and design are our intellectual property. 
          Market data and content may be subject to third-party rights.
        </p>

        <h2>9. Limitation of Liability</h2>
        <p>
          ScoreMarkt is provided "as is" without warranties of any kind. We are not liable for 
          any damages arising from your use of the Service, including but not limited to:
        </p>
        <ul>
          <li>Trading losses</li>
          <li>Technical failures</li>
          <li>Third-party actions</li>
          <li>Regulatory actions</li>
        </ul>

        <h2>10. Modifications</h2>
        <p>
          We may modify these terms at any time. Continued use of the Service constitutes 
          acceptance of any changes.
        </p>

        <h2>11. Governing Law</h2>
        <p>
          These terms are governed by applicable law. Any disputes shall be resolved 
          through binding arbitration.
        </p>

        <h2>12. Contact</h2>
        <p>
          Questions about these terms? Contact us at{' '}
          <a href="mailto:legal@scoremarkt.com">legal@scoremarkt.com</a>
        </p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .prose h1 { @apply text-4xl font-display font-bold mb-8 text-white; }
  .prose h2 { @apply text-xl font-semibold mt-10 mb-4 text-white; }
  .prose p { @apply text-white/70 leading-relaxed mb-4; }
  .prose ul { @apply list-disc pl-6 space-y-2 text-white/70 mb-4; }
  .prose a { @apply text-lime-400 hover:underline; }
  .prose strong { @apply text-white font-semibold; }
</style>
