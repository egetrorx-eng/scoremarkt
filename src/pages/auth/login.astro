---
/**
 * Login / Connect Page - ScoreMarkt
 * ═══════════════════════════════════════════════════════════════
 * Authentication page with wallet and social login options.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import LoginButton from '@/components/react/LoginButton';

const loginMethods = [
  {
    id: 'gmail',
    name: 'Continue with Gmail',
    description: 'Easiest option - no crypto needed',
    icon: 'gmail',
    primary: true,
  },
  {
    id: 'metamask',
    name: 'MetaMask',
    description: 'Browser wallet',
    icon: 'metamask',
    primary: false,
  },
  {
    id: 'rabby',
    name: 'Rabby Wallet',
    description: 'Multi-chain wallet',
    icon: 'rabby',
    primary: false,
  },
  {
    id: 'walletconnect',
    name: 'WalletConnect',
    description: 'Mobile wallets',
    icon: 'walletconnect',
    primary: false,
  },
];

const features = [
  'Trade on 150+ football markets',
  'No minimum deposit',
  'Instant withdrawals',
  'Real-time price updates',
];
---

<BaseLayout 
  title="Connect" 
  description="Sign in to ScoreMarkt to start trading on football prediction markets."
>
  <div class="min-h-screen flex">
    <!-- Left Side - Login Form -->
    <div class="flex-1 flex items-center justify-center p-8">
      <div class="w-full max-w-md">
        {/* Logo */}
        <a href="/" class="flex items-center gap-3 mb-8">
          <div class="relative w-10 h-10 flex items-center justify-center">
            <div class="absolute inset-0 bg-lime-500 rounded-xl rotate-45"></div>
            <svg class="relative w-6 h-6 text-midnight-900" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
            </svg>
          </div>
          <span class="font-display font-bold text-xl text-white">ScoreMarkt</span>
        </a>

        <h1 class="text-3xl font-display font-bold mb-2">Welcome back</h1>
        <p class="text-white/60 mb-8">
          Connect to start trading on football prediction markets.
        </p>

        {/* Primary Login - Gmail */}
        <LoginButton 
          client:load 
          className="w-full flex items-center justify-center gap-3 bg-white text-gray-900 font-semibold py-4 px-6 rounded-xl hover:bg-gray-100 transition-colors mb-4"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Continue with Gmail
        </LoginButton>

        <p class="text-xs text-white/40 text-center mb-8">
          Powered by Privy - Your wallet is created automatically
        </p>

        {/* Divider */}
        <div class="flex items-center gap-4 mb-8">
          <div class="flex-1 h-px bg-midnight-600"></div>
          <span class="text-sm text-white/40">or connect wallet</span>
          <div class="flex-1 h-px bg-midnight-600"></div>
        </div>

        {/* Wallet Options */}
        <div class="grid grid-cols-3 gap-3 mb-8">
          <LoginButton client:load className="flex flex-col items-center gap-2 p-4 rounded-xl bg-midnight-800 border border-midnight-600 hover:border-lime-500/30 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-orange-500/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-orange-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.8 11.4l-1.8-5.6c-.2-.6-.8-1-1.4-1H5.4c-.6 0-1.2.4-1.4 1L2.2 11.4c-.1.2-.2.4-.2.6v6c0 .6.4 1 1 1h1v-2c0-.6.4-1 1-1h12c.6 0 1 .4 1 1v2h1c.6 0 1-.4 1-1v-6c0-.2-.1-.4-.2-.6zM12 13c-1.7 0-3-1.3-3-3s1.3-3 3-3 3 1.3 3 3-1.3 3-3 3z"/>
              </svg>
            </div>
            <span class="text-xs text-white/60 group-hover:text-white">MetaMask</span>
          </LoginButton>

          <LoginButton client:load className="flex flex-col items-center gap-2 p-4 rounded-xl bg-midnight-800 border border-midnight-600 hover:border-lime-500/30 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-blue-400" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="10"/>
              </svg>
            </div>
            <span class="text-xs text-white/60 group-hover:text-white">Rabby</span>
          </LoginButton>

          <LoginButton client:load className="flex flex-col items-center gap-2 p-4 rounded-xl bg-midnight-800 border border-midnight-600 hover:border-lime-500/30 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-blue-600/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-blue-500" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
              </svg>
            </div>
            <span class="text-xs text-white/60 group-hover:text-white">WalletConnect</span>
          </LoginButton>
        </div>

        {/* Show more wallets */}
        <button class="w-full text-sm text-white/50 hover:text-white py-2 transition-colors">
          Show 20+ more wallets →
        </button>

        {/* Terms */}
        <p class="text-xs text-white/30 text-center mt-8 leading-relaxed">
          By connecting, you agree to our{' '}
          <a href="/terms" class="text-white/50 hover:text-lime-400">Terms of Service</a>
          {' '}and{' '}
          <a href="/privacy" class="text-white/50 hover:text-lime-400">Privacy Policy</a>
        </p>
      </div>
    </div>

    {/* Right Side - Feature Panel (Hidden on mobile) */}
    <div class="hidden lg:flex lg:w-1/2 bg-gradient-to-br from-midnight-800 to-midnight-900 border-l border-midnight-700 items-center justify-center p-16">
      <div class="max-w-md">
        <h2 class="text-3xl font-display font-bold mb-6">
          Trade on <span class="gradient-text">Football</span> Predictions
        </h2>
        <p class="text-white/60 mb-8 text-lg">
          Join thousands of football fans trading on match outcomes, tournaments, and player performance.
        </p>

        <ul class="space-y-4">
          {features.map(feature => (
            <li class="flex items-center gap-3">
              <div class="w-6 h-6 rounded-full bg-lime-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-lime-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <span class="text-white/80">{feature}</span>
            </li>
          ))}
        </ul>

        {/* Stats */}
        <div class="grid grid-cols-3 gap-6 mt-12 pt-8 border-t border-midnight-600">
          <div>
            <div class="text-2xl font-bold font-mono text-lime-400">$12M+</div>
            <div class="text-sm text-white/50">Volume</div>
          </div>
          <div>
            <div class="text-2xl font-bold font-mono text-lime-400">2.5K+</div>
            <div class="text-sm text-white/50">Traders</div>
          </div>
          <div>
            <div class="text-2xl font-bold font-mono text-lime-400">150+</div>
            <div class="text-sm text-white/50">Markets</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
