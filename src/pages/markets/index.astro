---
/**
 * Markets Page - ScoreMarkt
 * ═══════════════════════════════════════════════════════════════
 * Browse all football prediction markets with filters.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/astro/Header.astro';
import Footer from '@/components/astro/Footer.astro';
import GlobalAlphaFeed from '@/components/react/GlobalAlphaFeed';
import WatchlistSidebar from '@/components/react/WatchlistSidebar';
import MarketExplorer from '@/components/react/MarketExplorer';
import { getMarkets, getFeaturedMarkets } from '@/lib/polymarket/gamma';

const feedMarkets = await getFeaturedMarkets(10);

// Get query params for filtering
const url = Astro.url;
const leagueParam = url.searchParams.get('league') || 'all';
const statusParam = url.searchParams.get('status') || 'open';
const sortParam = (url.searchParams.get('sort') as any) || 'volume';

// Fetch live markets based on params
let markets = await getMarkets({
  league: leagueParam === 'all' ? undefined : leagueParam,
  status: statusParam === 'all' ? 'all' : (statusParam as any),
  sort: sortParam === 'alpha' ? 'volume' : sortParam, // Default to volume if alpha requested from API
  limit: 50
});

// Post-process for AI Alpha sorting
if (sortParam === 'alpha') {
  const getAlpha = (m: any) => 65 + (m.id.split('').reduce((acc: number, char: string) => acc + char.charCodeAt(0), 0) % 30);
  markets = [...markets].sort((a, b) => getAlpha(b) - getAlpha(a));
}

// For UI state tracking
const league = leagueParam;
const status = statusParam;
const sort = sortParam;

// Available filters
const leagues = [
  { value: 'all', label: 'All Leagues' },
  { value: 'premier-league', label: 'Premier League' },
  { value: 'champions-league', label: 'Champions League' },
  { value: 'la-liga', label: 'La Liga' },
  { value: 'bundesliga', label: 'Bundesliga' },
  { value: 'serie-a', label: 'Serie A' },
  { value: 'ligue-1', label: 'Ligue 1' },
];

const sortOptions = [
  { value: 'volume', label: 'Highest Volume' },
  { value: 'liquidity', label: 'Most Liquid' },
  { value: 'alpha', label: 'Highest Alpha' },
  { value: 'newest', label: 'Newest' },
  { value: 'ending', label: 'Ending Soon' },
];

const statusOptions = [
  { value: 'open', label: 'Open' },
  { value: 'closed', label: 'Resolved' },
  { value: 'all', label: 'All' },
];
---

<BaseLayout 
  title="Football Markets" 
  description="Browse all football prediction markets. Trade on Premier League, Champions League, La Liga and more."
>
  <Header />

  <main class="min-h-screen">
    <!-- Page Header -->
    <section class="py-8 md:py-12 border-b border-midnight-700/50">
      <div class="container-wide">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h1 class="text-3xl md:text-4xl font-display font-bold">Football Markets</h1>
            <p class="text-white/50 mt-1">
              {markets.length} active markets
            </p>
          </div>
          
          <div class="hidden md:block">
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-lime-500/5 border border-lime-500/20 text-[10px] font-bold text-lime-400 uppercase tracking-widest">
              <span class="w-2 h-2 rounded-full bg-lime-500 animate-pulse"></span>
              Live Feed Active
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Filters & Content -->
    <section class="py-8 relative">
      <!-- Background Glow -->
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-lime-500/5 rounded-full blur-[120px] pointer-events-none"></div>
      
      <div class="container-wide relative z-10">
        <div class="flex flex-col lg:flex-row gap-8">
          <!-- Sidebar Filters -->
          <aside class="lg:w-64 flex-shrink-0">
            <div class="lg:sticky lg:top-24 space-y-8">
              <!-- League Filter -->
              <div class="card p-5 border border-white/10 bg-midnight-800/40 backdrop-blur-md">
                <label class="text-[10px] font-bold text-white/30 uppercase tracking-[0.2em] mb-4 block">League</label>
                <div class="space-y-1.5">
                  {leagues.map(l => (
                    <a
                      href={`/markets?league=${l.value}&sort=${sort}&status=${status}`}
                      class:list={[
                        'block px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-300',
                        league === l.value 
                          ? 'bg-lime-500/10 text-lime-400 border border-lime-500/30 shadow-[0_0_15px_rgba(191,255,0,0.1)]' 
                          : 'text-white/50 hover:text-white hover:bg-white/5'
                      ]}
                    >
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>

              <!-- Status Filter -->
              <div class="card p-5 border border-white/10 bg-midnight-800/40 backdrop-blur-md">
                <label class="text-[10px] font-bold text-white/30 uppercase tracking-[0.2em] mb-4 block">Market Status</label>
                <div class="flex bg-midnight-900/50 rounded-xl p-1 border border-white/5">
                  {statusOptions.map(s => (
                    <a
                      href={`/markets?league=${league}&sort=${sort}&status=${s.value}`}
                      class:list={[
                        'flex-1 text-center px-2 py-2 rounded-lg text-xs font-bold uppercase tracking-wider transition-all duration-300',
                        status === s.value 
                          ? 'bg-midnight-600 text-white shadow-lg' 
                          : 'text-white/40 hover:text-white'
                      ]}
                    >
                      {s.label}
                    </a>
                  ))}
                </div>
              </div>

              <!-- Sort -->
              <div class="card p-5 border border-white/10 bg-midnight-800/40 backdrop-blur-md">
                <label class="text-[10px] font-bold text-white/30 uppercase tracking-[0.2em] mb-4 block">Sort By</label>
                <div class="relative">
                  <select 
                    id="sort-select"
                    class="w-full bg-midnight-900/50 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:ring-2 focus:ring-lime-500/30 appearance-none transition-all cursor-pointer"
                  >
                    {sortOptions.map(s => (
                      <option value={s.value} selected={sort === s.value}>
                        {s.label}
                      </option>
                    ))}
                  </select>
                  <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/40">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                </div>
              </div>

              <!-- Watchlist Sidebar -->
              <div class="card p-5 border border-white/10 bg-midnight-800/40 backdrop-blur-md">
                <WatchlistSidebar client:load />
              </div>
            </div>
          </aside>

          <!-- Market Content Area -->
          <div class="flex-1 min-w-0">
            <MarketExplorer 
              initialMarkets={markets} 
              emptyMessage={`No ${league !== 'all' ? league.replace('-', ' ') : ''} markets found`}
              client:load 
            />
          </div>

          <!-- Alpha Feed Sidebar -->
          <aside class="lg:w-80 flex-shrink-0">
            <div class="lg:sticky lg:top-24">
              <div class="card p-6 border border-white/10 bg-midnight-800/40 backdrop-blur-md">
                <GlobalAlphaFeed markets={feedMarkets} client:load />
              </div>
            </div>
          </aside>

            {/* Pagination placeholder */}
            {markets.length >= 6 && (
              <div class="flex justify-center mt-12">
                <div class="flex items-center gap-2">
                  <button class="btn-secondary btn-sm" disabled>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                  </button>
                  <span class="px-4 py-2 text-sm text-white/50">Page 1 of 1</span>
                  <button class="btn-secondary btn-sm" disabled>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script define:vars={{ league, sort, status }}>
  // Handle sort select
  const sortSelect = document.getElementById('sort-select');
  if (sortSelect) {
    sortSelect.addEventListener('change', (e) => {
      const newSort = e.target.value;
      window.location.href = `/markets?league=${league}&status=${status}&sort=${newSort}`;
    });
  }
</script>
